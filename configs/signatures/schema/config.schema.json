{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/metacpg/config.schema.json",
  "title": "metaCpG analysis configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "methodology", "analysis_id", "matrix", "phenotype", "endpoints", "selection", "output_dir"],
  "properties": {
    "schema_version": {"const": 1},
    "methodology": {"const": "legacy_exact"},
    "analysis_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "orientation", "scale", "feature_id_column"],
      "properties": {
        "path": {"type": "string"}, "separator": {"type": "string"},
        "orientation": {"enum": ["features_by_samples", "samples_by_features"]},
        "scale": {"enum": ["beta", "m_value"]},
        "feature_id_column": {"oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0}]}
      }
    },
    "phenotype": {
      "type": "object", "additionalProperties": false, "required": ["path", "sample_id_column"],
      "properties": {"path": {"type": "string"}, "separator": {"type": "string"}, "sample_id_column": {"type": "string"}}
    },
    "endpoints": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "time", "status", "prediction_time"],
        "properties": {"name": {"type": "string"}, "time": {"type": "string"}, "status": {"type": "string"},
          "prediction_time": {"type": "number", "exclusiveMinimum": 0},
          "group_column": {"type": "string",
            "description": "Optional phenotype column with two or more cohort levels; splits this single endpoint into a per-cohort random-effects meta-analysis."}}}
    },
    "covariates": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["column", "type", "mode"], "properties": {"column": {"type": "string"},
        "type": {"enum": ["categorical", "numeric"]}, "mode": {"enum": ["strata", "adjust"]}}}},
    "final_model": {"type": "object", "additionalProperties": false,
      "properties": {"weight_refit": {"enum": ["covariate_aware", "legacy_unadjusted"],
        "default": "covariate_aware",
        "description": "Whether exported CpG weights are refitted with configured covariates/strata or with the historical unadjusted full-data Cox model."}}},
    "search": {"type": "object", "additionalProperties": false,
      "properties": {"min_features": {"type": "integer", "minimum": 1}, "max_features": {"type": "integer", "minimum": 1},
        "step": {"type": "integer", "minimum": 1}, "cross_validation": {"const": "loo"},
        "feature_count_override": {"type": ["integer", "null"], "minimum": 1}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["mode", "feature_count"],
      "properties": {"mode": {"enum": ["manual", "max_auc"]},
        "feature_count": {"type": ["integer", "null"], "minimum": 1}}},
    "execution": {"type": "object", "additionalProperties": false,
      "properties": {"workers": {"type": "integer", "minimum": 1},
        "memory_budget": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 1}, {"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
        "heartbeat_seconds": {"type": "number", "minimum": 0},
        "progress": {"type": "boolean"},
        "seed": {"type": "integer"},
        "resume_run_id": {"type": ["string", "null"]},
        "slurm": {"type": "object", "additionalProperties": true}}},
    "annotation": {"type": ["object", "null"], "additionalProperties": false,
      "properties": {"path": {"type": "string"}, "separator": {"type": "string"}, "feature_id_column": {"type": "string"}}},
    "validation": {"type": "object", "additionalProperties": false,
      "properties": {"allow_unmatched_samples": {"type": "boolean"}}},
    "output_dir": {"type": "string"}
  }
}
